  displayName: "\u0420\u0435\u0433\u0435\u043D\u0435\u0440\u0430\u0442\u0438\u0432\u043D\u0430\u044F
    \u0416\u0435\u043B\u0435\u0437\u0430"
  description: "\u0421\u043F\u0435\u0446\u0438\u0430\u043B\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
    \u0441\u0435\u043A\u0440\u0435\u0442\u043E\u0440\u043D\u044B\u0439 \u043E\u0440\u0433\u0430\u043D,
    \u0432\u044B\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u044E\u0449\u0438\u0439
    \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441 \u0444\u0430\u043A\u0442\u043E\u0440\u043E\u0432
    \u0440\u043E\u0441\u0442\u0430, \u0441\u0438\u0433\u043D\u0430\u043B\u044C\u043D\u044B\u0445
    \u0431\u0435\u043B\u043A\u043E\u0432 \u0438 \u0431\u0438\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438
    \u0430\u043A\u0442\u0438\u0432\u043D\u044B\u0445 \u043C\u0435\u0442\u0430\u0431\u043E\u043B\u0438\u0442\u043E\u0432.
    \u041F\u043E\u0441\u0442\u0443\u043F\u0430\u044F \u0432 \u0433\u0435\u043C\u043E\u043B\u0438\u043C\u0444\u0443,
    \u043E\u043D\u0438 \u0441\u0442\u0438\u043C\u0443\u043B\u0438\u0440\u0443\u044E\u0442
    \u0434\u0435\u043B\u0435\u043D\u0438\u0435 \u043A\u043B\u0435\u0442\u043E\u043A,
    \u0441\u0438\u043D\u0442\u0435\u0437 \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u043D\u044B\u0445
    \u0431\u0435\u043B\u043A\u043E\u0432 \u0438 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435
    \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0451\u043D\u043D\u044B\u0445 \u0442\u043A\u0430\u043D\u0435\u0439.
    \u041D\u0430\u0438\u0431\u043E\u043B\u044C\u0448\u0430\u044F \u043A\u043E\u043D\u0446\u0435\u043D\u0442\u0440\u0430\u0446\u0438\u044F
    \u0440\u0435\u0433\u0435\u043D\u0435\u0440\u0430\u0442\u0438\u0432\u043D\u044B\u0445
    \u0444\u0430\u043A\u0442\u043E\u0440\u043E\u0432 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u0432 \u0436\u0438\u0437\u043D\u0435\u043D\u043D\u043E \u0432\u0430\u0436\u043D\u044B\u0445
    \u0442\u043A\u0430\u043D\u044F\u0445 \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0433\u043E
    \u0442\u0435\u043B\u0430, \u0433\u0434\u0435 \u043D\u0435\u043F\u0440\u0435\u0440\u044B\u0432\u043D\u043E
    \u0437\u0430\u043F\u0443\u0441\u043A\u0430\u044E\u0442\u0441\u044F \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u044B
    \u043A\u043B\u0435\u0442\u043E\u0447\u043D\u043E\u0439 \u0440\u0435\u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0438."
