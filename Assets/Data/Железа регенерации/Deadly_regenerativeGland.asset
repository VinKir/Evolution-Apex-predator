  displayName: "\u0421\u043C\u0435\u0440\u0442\u0435\u043B\u044C\u043D\u0430\u044F"
  bodyPart: {fileID: 11400000, guid: f5c144b7e2daa3b44874a4d22ce8cc78, type: 2}
  unlockLevel: 5
  description: "\u0416\u0435\u043B\u0435\u0437\u0430 \u043F\u043E\u0434\u0432\u0435\u0440\u0433\u0430\u0435\u0442\u0441\u044F
    \u044D\u043A\u0441\u0442\u0440\u0435\u043C\u0430\u043B\u044C\u043D\u043E\u0439
    \u0433\u0438\u043F\u0435\u0440\u0444\u0443\u043D\u043A\u0446\u0438\u0438, \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u044F\u0441\u044C
    \u0432 \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438 \u043D\u0435\u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0438\u0440\u0443\u0435\u043C\u044B\u0439
    \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A \u0440\u0435\u0433\u0435\u043D\u0435\u0440\u0430\u0442\u0438\u0432\u043D\u044B\u0445
    \u0444\u0430\u043A\u0442\u043E\u0440\u043E\u0432. \u0422\u043A\u0430\u043D\u0438
    \u043F\u043E\u043B\u0443\u0447\u0430\u044E\u0442 \u043A\u043E\u043B\u043E\u0441\u0441\u0430\u043B\u044C\u043D\u044B\u0439
    \u043F\u043E\u0442\u043E\u043A \u0441\u0438\u0433\u043D\u0430\u043B\u043E\u0432
    \u0440\u043E\u0441\u0442\u0430, \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0449\u0438\u0439
    \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0442\u044C
    \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u044F \u0441 \u043D\u0435\u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E\u0439
    \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C\u044E. \u041E\u0434\u043D\u0430\u043A\u043E
    \u043D\u0430\u0440\u0443\u0448\u0435\u043D\u043D\u0430\u044F \u0440\u0435\u0433\u0443\u043B\u044F\u0446\u0438\u044F
    \u0441\u0435\u043A\u0440\u0435\u0446\u0438\u0438 \u043F\u0435\u0440\u0438\u043E\u0434\u0438\u0447\u0435\u0441\u043A\u0438
    \u0432\u044B\u0437\u044B\u0432\u0430\u0435\u0442 \u0441\u0438\u0441\u0442\u0435\u043C\u043D\u044B\u0439
    \u0440\u0435\u0433\u0435\u043D\u0435\u0440\u0430\u0442\u0438\u0432\u043D\u044B\u0439
    \u0441\u0431\u043E\u0439: \u043D\u0435\u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0438\u0440\u0443\u0435\u043C\u0430\u044F
    \u043A\u043B\u0435\u0442\u043E\u0447\u043D\u0430\u044F \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C
    \u0438 \u043C\u0435\u0442\u0430\u0431\u043E\u043B\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u043A\u043E\u043B\u043B\u0430\u043F\u0441 \u043C\u043E\u0433\u0443\u0442 \u043F\u0440\u0438\u0432\u0435\u0441\u0442\u0438
    \u043A \u0432\u043D\u0435\u0437\u0430\u043F\u043D\u043E\u0439 \u0441\u043C\u0435\u0440\u0442\u0438
    \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043C\u0430."
