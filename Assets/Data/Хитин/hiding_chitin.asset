  displayName: "\u0421\u043A\u0440\u044B\u0432\u0430\u044E\u0449\u0438\u0439 \u0445\u0438\u0442\u0438\u043D"
  unlockLevel: 5
  description: "\u041F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C
    \u0445\u0438\u0442\u0438\u043D\u043E\u0432\u044B\u0445 \u043F\u043B\u0430\u0441\u0442\u0438\u043D
    \u043F\u0440\u0438\u043E\u0431\u0440\u0435\u0442\u0430\u0435\u0442 \u043C\u0438\u043A\u0440\u043E\u0441\u043A\u043E\u043F\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u043D\u0435\u0440\u043E\u0432\u043D\u043E\u0441\u0442\u0438, \u0440\u0430\u0441\u0441\u0435\u0438\u0432\u0430\u044E\u0449\u0438\u0435
    \u043E\u0442\u0440\u0430\u0436\u0451\u043D\u043D\u044B\u0439 \u0441\u0432\u0435\u0442.
    \u041F\u0438\u0433\u043C\u0435\u043D\u0442\u0430\u0446\u0438\u044F \u0438 \u043C\u0438\u043A\u0440\u043E\u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u0430
    \u043F\u0430\u043D\u0446\u0438\u0440\u044F \u043B\u0443\u0447\u0448\u0435 \u043F\u043E\u0434\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u044E\u0442\u0441\u044F
    \u043F\u043E\u0434 \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0449\u0443\u044E
    \u0441\u0440\u0435\u0434\u0443, \u0434\u0435\u043B\u0430\u044F \u0441\u0438\u043B\u0443\u044D\u0442
    \u043C\u0435\u043D\u0435\u0435 \u0437\u0430\u043C\u0435\u0442\u043D\u044B\u043C.
    \u0412 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443
    \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E
    \u043F\u0440\u043E\u0449\u0435 \u0441\u043B\u0438\u0432\u0430\u0442\u044C\u0441\u044F
    \u0441 \u043E\u043A\u0440\u0443\u0436\u0435\u043D\u0438\u0435\u043C \u0438 \u043E\u0441\u0442\u0430\u0432\u0430\u0442\u044C\u0441\u044F
    \u043D\u0435\u0437\u0430\u043C\u0435\u0447\u0435\u043D\u043D\u044B\u043C."
